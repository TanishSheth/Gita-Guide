# OPENAI_API_KEY is optional now. Each signed-in user can add their own key
# in Settings. The default answer model is local Ollama (free).
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Local Ollama (default LLM). Install from https://ollama.com then:
#   ollama pull llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_DEFAULT_MODEL=llama3.2

# Optional: LangSmith tracing for RAG observability (latency, prompts, feedback)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=gita-guide

# Auth (optional overrides)
# AUTH_IDLE_MINUTES=15
# AUTH_SESSION_HOURS=12
# AUTH_REMEMBER_DAYS=30
# AUTH_RESET_MINUTES=60
# Public frontend origin used in password-reset links
# APP_PUBLIC_URL=http://localhost:5173

# Optional SMTP for forgot-password emails. If unset, the API returns a
# one-time reset URL in the response (for local/dev) and logs it.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Gita Guide <noreply@example.com>
# SMTP_TLS=true
